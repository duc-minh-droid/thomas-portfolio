---
// Die-cut paper stickers for the page margins. Flat colours + ink outline, drawn to match the sketchbook.
// Brand marks come from simple-icons (already a dependency); the rest are drawn by hand below.
import { siClaude, siPython, siRust, siTypescript } from "simple-icons";

interface Props {
  kind: string;
  size?: number;
  rotate?: number;
  speed?: number;
  class?: string;
}
const { kind, size = 88, rotate = 0, speed, class: cls = "" } = Astro.props;

const INK = "#25221f";
const o = `stroke="${INK}" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"`;
const thin = `stroke="${INK}" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"`;
const hand = `font-family="Caveat, 'Segoe Print', cursive" font-weight="700" text-anchor="middle"`;
const mono = `font-family="'JetBrains Mono', ui-monospace, monospace" font-weight="800" text-anchor="middle"`;

const art: Record<string, string> = {
  // London: double-decker
  bus: `
    <rect x="30" y="14" width="40" height="13" rx="4" fill="#fffdf8" ${thin}/>
    <text x="50" y="24.4" font-size="9.5" fill="${INK}" ${mono}>LONDON</text>
    <rect x="9" y="30" width="82" height="46" rx="9" fill="#d9322c" ${o}/>
    <path d="M9 53H91" ${thin}/>
    <g fill="#bfe6f2" ${thin}>
      <rect x="16" y="35" width="13" height="12" rx="2.5"/><rect x="33" y="35" width="13" height="12" rx="2.5"/>
      <rect x="50" y="35" width="13" height="12" rx="2.5"/><rect x="67" y="35" width="17" height="12" rx="2.5"/>
      <rect x="16" y="58" width="13" height="11" rx="2.5"/><rect x="33" y="58" width="13" height="11" rx="2.5"/>
      <rect x="50" y="58" width="13" height="11" rx="2.5"/>
    </g>
    <rect x="68" y="57" width="16" height="19" rx="2.5" fill="#9fd3e3" ${thin}/>
    <circle cx="27" cy="77" r="8.5" fill="#34302c" ${o}/><circle cx="27" cy="77" r="3" fill="#bdb6aa"/>
    <circle cx="73" cy="77" r="8.5" fill="#34302c" ${o}/><circle cx="73" cy="77" r="3" fill="#bdb6aa"/>`,

  // Exeter: ticket stub
  exeter: `
    <path d="M7 26H93V42a8 8 0 0 0 0 16V74H7V58a8 8 0 0 0 0-16Z" fill="#1d5c3a" ${o}/>
    <path d="M70 31V69" stroke="#cfe9d9" stroke-width="2" stroke-dasharray="3 4" fill="none"/>
    <text x="38" y="49" font-size="23" fill="#fff" ${hand}>Exeter</text>
    <text x="38" y="63" font-size="9" fill="#cfe9d9" ${mono}>CS · 2026</text>
    <path d="M81 42l2.4 5 5.4.6-4 3.7 1.1 5.3-4.9-2.7-4.9 2.7 1.1-5.3-4-3.7 5.4-.6z" fill="#f2b632" stroke="${INK}" stroke-width="1.6" stroke-linejoin="round"/>`,

  // quant dev one day
  candles: `
    <rect x="8" y="8" width="84" height="84" rx="14" fill="#fffdf8" ${o}/>
    <g ${thin}>
      <path d="M26 30V74M42 24V62M58 38V70M74 18V56" fill="none"/>
      <rect x="20" y="44" width="12" height="22" rx="2" fill="#2a9d8f"/>
      <rect x="36" y="32" width="12" height="24" rx="2" fill="#e8604c"/>
      <rect x="52" y="46" width="12" height="18" rx="2" fill="#2a9d8f"/>
      <rect x="68" y="24" width="12" height="26" rx="2" fill="#2a9d8f"/>
    </g>
    <path d="M17 70C34 66 44 52 58 48S76 30 86 22" fill="none" stroke="#e0a526" stroke-width="2.6" stroke-dasharray="1 6" stroke-linecap="round"/>
    <text x="50" y="86" font-size="14" fill="${INK}" ${hand}>quant, one day</text>`,

  // fuel
  coffee: `
    <path d="M40 10c-6 6 6 9 0 16M54 8c-6 6 6 9 0 16" fill="none" stroke="#9a8f80" stroke-width="3" stroke-linecap="round"/>
    <path d="M18 34H74V62a22 22 0 0 1-22 22H40A22 22 0 0 1 18 62Z" fill="#fffdf8" ${o}/>
    <path d="M74 42h6a10 10 0 0 1 0 20h-7" fill="none" ${o}/>
    <path d="M20 40H72V46H20Z" fill="#6b4226" stroke="${INK}" stroke-width="2"/>
    <text x="46" y="70" font-size="20" fill="#e8604c" ${hand}>fuel</text>
    <ellipse cx="46" cy="90" rx="30" ry="4" fill="#25221f" opacity=".18"/>`,

  // lately: a lot of Rust
  rust: `
    <circle cx="50" cy="50" r="42" fill="#f6d9b4" ${o}/>
    <g transform="translate(15 15) scale(2.92)"><path d="${siRust.path}" fill="${INK}"/></g>`,

  python: `
    <circle cx="50" cy="50" r="42" fill="#fffdf8" ${o}/>
    <g transform="translate(20 20) scale(2.5)"><path d="${siPython.path}" fill="#3776ab"/></g>`,

  ts: `
    <rect x="9" y="9" width="82" height="82" rx="14" fill="#fffdf8" ${o}/>
    <g transform="translate(19 19) scale(2.7)"><path d="${siTypescript.path}" fill="#3178c6"/></g>`,

  claude: `
    <rect x="8" y="14" width="84" height="64" rx="16" fill="#fffdf8" ${o}/>
    <g transform="translate(26 18) scale(2.1)"><path d="${siClaude.path}" fill="#d97757"/></g>
    <rect x="14" y="66" width="72" height="22" rx="7" fill="#d97757" ${o}/>
    <text x="50" y="82" font-size="15" fill="#fff" ${hand}>Claude Code</text>`,

  // terminal chip
  git: `
    <rect x="5" y="30" width="90" height="40" rx="10" fill="#1c1f24" ${o}/>
    <circle cx="17" cy="40" r="2.6" fill="#ff5f56"/><circle cx="25" cy="40" r="2.6" fill="#ffbd2e"/><circle cx="33" cy="40" r="2.6" fill="#27c93f"/>
    <text x="50" y="62" font-size="13" fill="#7ee787" ${mono}>$ git push</text>`,

  // 4x hackathon winner
  medal: `
    <path d="M28 6h20l10 30H38Z" fill="#2d5bd0" ${o}/>
    <path d="M72 6H52L42 36h20Z" fill="#e8604c" ${o}/>
    <circle cx="50" cy="62" r="29" fill="#f2b632" ${o}/>
    <circle cx="50" cy="62" r="21" fill="none" stroke="#b97d0a" stroke-width="2" stroke-dasharray="2 4"/>
    <path d="M50 46l4.4 9.2 10 1.3-7.3 7 1.9 10-9-4.9-9 4.9 1.9-10-7.3-7 10-1.3z" fill="#fff4cf" stroke="${INK}" stroke-width="2" stroke-linejoin="round"/>
    <circle cx="80" cy="82" r="13" fill="#e8604c" ${o}/>
    <text x="80" y="87" font-size="15" fill="#fff" ${hand}>4×</text>`,

  // agents
  robot: `
    <path d="M50 20V10" ${o} fill="none"/><circle cx="50" cy="8" r="5" fill="#e8604c" ${o}/>
    <rect x="12" y="38" width="8" height="20" rx="3" fill="#2a9d8f" ${thin}/><rect x="80" y="38" width="8" height="20" rx="3" fill="#2a9d8f" ${thin}/>
    <rect x="18" y="20" width="64" height="62" rx="16" fill="#7ac7c0" ${o}/>
    <rect x="27" y="35" width="46" height="24" rx="10" fill="#fffdf8" ${thin}/>
    <circle cx="39" cy="47" r="5.2" fill="${INK}"/><circle cx="61" cy="47" r="5.2" fill="${INK}"/>
    <circle cx="40.6" cy="45.4" r="1.6" fill="#fff"/><circle cx="62.6" cy="45.4" r="1.6" fill="#fff"/>
    <path d="M38 69q12 9 24 0" fill="none" ${o}/>
    <circle cx="27" cy="66" r="3.4" fill="#f4a3b6"/><circle cx="73" cy="66" r="3.4" fill="#f4a3b6"/>`,

  // the band
  headphones: `
    <path d="M18 62V50a32 32 0 0 1 64 0V62" fill="none" stroke="${INK}" stroke-width="9" stroke-linecap="round"/>
    <path d="M18 62V50a32 32 0 0 1 64 0V62" fill="none" stroke="#7b5cc4" stroke-width="4.5" stroke-linecap="round"/>
    <rect x="10" y="56" width="20" height="30" rx="9" fill="#e8604c" ${o}/>
    <rect x="70" y="56" width="20" height="30" rx="9" fill="#e8604c" ${o}/>
    <path d="M45 40v-15l13-4v15" fill="none" stroke="${INK}" stroke-width="3" stroke-linecap="round"/>
    <ellipse cx="42" cy="41" rx="4.6" ry="3.6" fill="${INK}"/><ellipse cx="55" cy="37" rx="4.6" ry="3.6" fill="${INK}"/>`,

  // sleep not found
  moon: `
    <path d="M62 10A40 40 0 1 0 90 62 32 32 0 0 1 62 10Z" fill="#f2c94c" ${o}/>
    <circle cx="40" cy="58" r="5" fill="#e0a526" stroke="${INK}" stroke-width="1.8"/><circle cx="52" cy="76" r="3.4" fill="#e0a526" stroke="${INK}" stroke-width="1.8"/>
    <path d="M74 24l2.4 5.4 5.6.8-4.1 4 1 5.7-4.9-2.7-5 2.7 1-5.7-4-4 5.5-.8z" fill="#fffdf8" ${thin}/>
    <text x="82" y="80" font-size="17" fill="${INK}" ${hand}>zzz</text>`,
};
---

<span class:list={["sticker", cls]} style={`--s:${size}px;--r:${rotate}deg`} data-speed={speed} aria-hidden="true">
  <svg class="sticker-art" viewBox="0 0 100 100" set:html={art[kind] ?? ""} />
</span>

<style is:global>
  .sticker {
    display: block;
    width: var(--s, 88px);
    rotate: var(--r, 0deg);
    pointer-events: none;
  }
  .sticker-art {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    pointer-events: auto;
    /* die-cut: a white paper rim around whatever the artwork's silhouette is, then a soft lift shadow */
    filter: drop-shadow(2.5px 0 0 #fff) drop-shadow(-2.5px 0 0 #fff) drop-shadow(0 2.5px 0 #fff) drop-shadow(0 -2.5px 0 #fff)
      drop-shadow(1.8px 1.8px 0 #fff) drop-shadow(-1.8px -1.8px 0 #fff) drop-shadow(1.8px -1.8px 0 #fff) drop-shadow(-1.8px 1.8px 0 #fff)
      drop-shadow(0 6px 5px rgb(60 40 10 / 0.3));
    transition: transform 260ms var(--ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));
  }
  @media (hover: hover) and (pointer: fine) {
    .sticker-art:hover { transform: rotate(calc(var(--r, 0deg) * -1)) scale(1.1) translateY(-3px); }
  }
  html.motion .sticker-art { opacity: 0; }
  @media (max-width: 1100px) { .sticker { width: calc(var(--s, 88px) * 0.72); } }
  @media (max-width: 600px) { .sticker { width: calc(var(--s, 88px) * 0.58); } }
</style>

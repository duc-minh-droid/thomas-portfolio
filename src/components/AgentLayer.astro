---
// Cursors for the agents that "build" the hero while the page loads. Driven by src/scripts/agents.ts.
const agents = [
  { id: "opus", name: "Opus" },
  { id: "gemini", name: "Gemini" },
  { id: "gpt", name: "GPT" },
  { id: "grok", name: "Grok" },
  { id: "muse", name: "Muse" },
];
const Q = Math.SQRT1_2;
// a tool is a polygon running from the cursor tip up-right at 45°
const poly = (pts: number[][]) => {
  const t = (s: number) => pts.map(([a, b]) => [Q * (a + s * b), Q * (-a + s * b)]);
  return "M" + [...t(1), ...t(-1).reverse()].map(([x, y]) => `${x.toFixed(2)} ${y.toFixed(2)}`).join("L") + "Z";
};
const pencil = {
  outline: poly([[0, 0], [5.2, 2.8], [19.4, 2.8], [20.4, 2.1]]),
  wood: poly([[0, 0], [5.2, 2.8]]),
  lead: poly([[0, 0], [1.9, 1]]),
  body: poly([[5.2, 2.8], [16.6, 2.8]]),
  eraser: poly([[16.6, 2.8], [19.4, 2.8], [20.4, 2.1]]),
};
const brush = {
  outline: poly([[0, 0], [1.4, 1.3], [4, 2.7], [6.8, 3], [10.4, 2.3], [21.4, 1.5], [22.4, 0.6]]),
  bristles: poly([[0, 0], [1.4, 1.3], [4, 2.7], [6.8, 3], [7.4, 2.5]]),
  ferrule: poly([[7.4, 2.5], [10.4, 2.3]]),
  handle: poly([[10.4, 1.9], [21.4, 1.5], [22.4, 0.6]]),
};
const pen = {
  outline: poly([[0, 0], [6.6, 3.1], [9.6, 3.3], [20.4, 3.1], [22, 2.2]]),
  nib: poly([[0, 0], [6.6, 3.1]]),
  grip: poly([[6.6, 3.1], [9.6, 3.3]]),
  barrel: poly([[9.6, 3.1], [20.4, 3.1], [22, 2.2]]),
};
const caret = "M-3.6 -11Q0 -11 0 -7.5V7.5Q0 11 -3.6 11M3.6 -11Q0 -11 0 -7.5M0 7.5Q0 11 3.6 11";
---

<div class="agent-layer" aria-hidden="true">
  <svg class="agent-defs" width="0" height="0" focusable="false">
    <defs>
      <linearGradient id="agent-gemini-fill" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#4285f4"></stop>
        <stop offset="0.55" stop-color="#9b72cb"></stop>
        <stop offset="1" stop-color="#d96570"></stop>
      </linearGradient>
    </defs>
  </svg>

  <p class="agent-skip-hint">
    <span class="for-pointer">Click anywhere to skip</span>
    <span class="for-touch">Tap anywhere to skip</span>
  </p>

  {
    agents.map((a) => (
      <div class="agent-cursor" data-agent={a.id} data-tool="pointer">
        <svg class="agent-glyph" viewBox="-14 -36 60 60" width="60" height="60">
          <g class="agent-tool agent-tool-pointer">
            <path class="agent-fill agent-halo" d="M0.8 0.8L18 7.3Q19 7.8 18 8.2L10.6 10.6L8.2 18Q7.8 19 7.3 18Z" />
          </g>
          <g class="agent-tool agent-tool-pencil">
            <path class="agent-halo-only" d={pencil.outline} />
            <path fill="#f3dcb6" d={pencil.wood} />
            <path fill="#2a2d33" d={pencil.lead} />
            <path class="agent-fill" d={pencil.body} />
            <path fill="#f4a3b6" d={pencil.eraser} />
          </g>
          <g class="agent-tool agent-tool-brush">
            <path class="agent-halo-only" d={brush.outline} />
            <path class="agent-fill" d={brush.bristles} />
            <path fill="#d5dae1" d={brush.ferrule} />
            <path fill="#2f343b" d={brush.handle} />
          </g>
          <g class="agent-tool agent-tool-pen">
            <path class="agent-halo-only" d={pen.outline} />
            <path fill="#e9edf2" d={pen.nib} />
            <path fill="#2f343b" d={pen.grip} />
            <path class="agent-fill" d={pen.barrel} />
          </g>
          <g class="agent-tool agent-tool-caret">
            <path class="agent-caret-halo" d={caret} />
            <path class="agent-caret" d={caret} />
          </g>
        </svg>
        <span class="agent-label">
          <b>{a.name}</b>
          <em class="agent-action"></em>
        </span>
      </div>
    ))
  }
</div>

<style is:global>
  :root {
    --ab-opus: #d97757;
    --ab-gpt: #10a37f;
    --ab-gemini: #8e7bd9;
    --ab-grok: #ff4d8d;
    --ab-muse: #0ea5e9;
  }

  .agent-layer {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    contain: strict;
    overflow: hidden;
  }
  .agent-defs { position: absolute; width: 0; height: 0; }

  .agent-cursor {
    --agent: var(--ab-opus);
    --agent-fill: var(--agent);
    --agent-label: var(--agent);
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    transform: translate(-160px, -160px);
    transition: opacity 0.22s;
    will-change: transform;
  }
  .agent-cursor.is-visible { opacity: 1; }
  .agent-cursor[data-agent="opus"] { --agent: var(--ab-opus); }
  .agent-cursor[data-agent="gpt"] { --agent: var(--ab-gpt); }
  .agent-cursor[data-agent="grok"] { --agent: var(--ab-grok); }
  .agent-cursor[data-agent="muse"] { --agent: var(--ab-muse); }
  .agent-cursor[data-agent="gemini"] {
    --agent: var(--ab-gemini);
    --agent-fill: url(#agent-gemini-fill);
    --agent-label: linear-gradient(100deg, #4285f4, #9b72cb 55%, #d96570);
  }

  .agent-glyph {
    position: absolute;
    top: -36px;
    left: -14px;
    overflow: visible;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--agent) 72%, transparent)) drop-shadow(0 1px 1.5px #00000038);
  }
  .agent-tool {
    opacity: 0;
    transform: scale(0.55);
    transform-box: view-box;
    transform-origin: 14px 36px;
    transition: opacity 0.14s, transform 0.24s cubic-bezier(0.2, 1.4, 0.4, 1);
  }
  .agent-cursor[data-tool="pointer"] .agent-tool-pointer,
  .agent-cursor[data-tool="pencil"] .agent-tool-pencil,
  .agent-cursor[data-tool="brush"] .agent-tool-brush,
  .agent-cursor[data-tool="pen"] .agent-tool-pen,
  .agent-cursor[data-tool="caret"] .agent-tool-caret {
    opacity: 1;
    transform: none;
  }
  .agent-fill { fill: var(--agent-fill); }
  .agent-halo { stroke: #fff; stroke-width: 1.5px; stroke-linejoin: round; paint-order: stroke; }
  .agent-halo-only { fill: #fff; stroke: #fff; stroke-width: 2.6px; stroke-linejoin: round; }
  .agent-caret, .agent-caret-halo { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .agent-caret { stroke: var(--agent); stroke-width: 2.2px; }
  .agent-caret-halo { stroke: #fff; stroke-width: 4.8px; }

  .agent-label {
    position: absolute;
    top: 19px;
    left: 15px;
    display: inline-flex;
    align-items: baseline;
    padding: 4px 9px 5px;
    border-radius: 999px;
    color: #fff;
    background: var(--agent-label);
    font: 12px/1.15 var(--font-body);
    letter-spacing: 0.01em;
    white-space: nowrap;
    box-shadow:
      inset 0 0 0 1px #ffffff38,
      0 4px 14px color-mix(in srgb, var(--agent) 40%, transparent),
      0 0 22px color-mix(in srgb, var(--agent) 34%, transparent);
  }
  .agent-label b { font-weight: 700; }
  .agent-action {
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    font-style: normal;
    font-weight: 500;
    transition: max-width 0.28s cubic-bezier(0.16, 1, 0.3, 1), margin 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s;
  }
  .agent-cursor.is-working .agent-action { max-width: 110px; margin-left: 5px; opacity: 0.9; }

  .agent-skip-hint {
    position: absolute;
    left: 50%;
    bottom: 18px;
    margin: 0;
    padding: 6px 12px 7px;
    border: 1px solid rgb(87 82 76 / 0.25);
    border-radius: 999px;
    background: rgb(246 241 231 / 0.82);
    backdrop-filter: blur(10px);
    color: var(--graphite, #57524c);
    font: 12px/1.2 var(--font-body);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.08);
    opacity: 0;
    transform: translate(-50%, 8px);
    transition: opacity 0.4s, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  html.ab-busy .agent-skip-hint { opacity: 1; transform: translate(-50%, 0); transition-delay: 1.2s; }
  .agent-skip-hint .for-touch { display: none; }
  @media (hover: none), (pointer: coarse) {
    .agent-skip-hint .for-pointer { display: none; }
    .agent-skip-hint .for-touch { display: inline; }
  }
  @media (max-width: 767px) { .agent-skip-hint { bottom: 64px; } }
  @media (prefers-reduced-motion: reduce) { .agent-layer { display: none; } }

  /* ---- what the agents build: hidden until an agent gets to it ---- */
  html.motion .topbar[data-hero-hide] { opacity: 1; }
  html.motion:not(.ab-built) :is(.topbar .logo, .pad-toggle, .cv-btn, .tab, .ctas .btn-sketch, .sticker-burst, .sticker-label):not(.ab-on) {
    opacity: 0;
    scale: 0.92;
  }
  html.motion:not(.ab-built) .ab-on { transition: opacity 0.3s, scale 0.4s cubic-bezier(0.2, 1.3, 0.4, 1); }

  /* a musician's floating notes start once Gemini has painted them */
  html.motion:not(.ab-built) .name-underline { visibility: hidden; }
  html.motion:not(.ab-built) .musician:not(.ab-on) .float-note { visibility: hidden; }

  .ab-shape {
    position: fixed;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    border: 1.5px solid var(--ab-muse);
    background: color-mix(in srgb, var(--ab-muse) 8%, transparent);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .ab-shape.is-drawing { opacity: 1; }
  .ab-shape.is-done { opacity: 0; }

  .ab-frame {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 5;
    width: 0;
    height: 0;
    border: 1.5px solid var(--ab-opus);
    border-radius: 18px;
    background: color-mix(in srgb, var(--ab-opus) 5%, transparent);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s;
  }
  .ab-frame.is-on { opacity: 1; }
  .ab-frame.is-done { opacity: 0; }
  .ab-dim {
    position: absolute;
    left: 50%;
    top: calc(100% + 9px);
    transform: translate(-50%);
    padding: 2px 6px 3px;
    border-radius: 5px;
    background: var(--ab-opus);
    color: #fff;
    font: 600 10px/1.2 var(--font-body);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* text being traced: the real glyphs go transparent while an SVG outline is drawn on top */
  .ab-drawing { position: relative; }
  .ab-drawing, .ab-drawing :not(.ab-lines):not(.ab-lines *) { -webkit-text-fill-color: transparent; }
  .ab-lines { position: absolute; left: 0; top: 0; width: 1px; height: 1px; overflow: visible; pointer-events: none; }
  .ab-lines text { stroke-linecap: round; stroke-linejoin: round; -webkit-text-fill-color: initial; }
</style>
